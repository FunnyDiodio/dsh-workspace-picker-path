{
  "name": "dsh-workspace-picker-path",
  "version": "1.3.0",
  "description": "Controls the directory the workspace picker opens at: a fixed custom path (typed, pasted, or chosen visually), or the last directory you successfully picked. Quoted paths and CJK are accepted; a This PC level reaches other drives.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FunnyDiodio/dsh-workspace-picker-path.git"
  },
  "homepage": "https://github.com/FunnyDiodio/dsh-workspace-picker-path#readme",
  "bugs": "https://github.com/FunnyDiodio/dsh-workspace-picker-path/issues",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "workspace",
    "directory-picker"
  ],
  "type": "module",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/icon-180.png",
    "screenshots.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
